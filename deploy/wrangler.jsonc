// Preview host for review copies (ADR 0003, skill preview-upload). Static assets only, no
// Worker code. The page is saved to var/preview/ (git-ignored), never into the repo.
{
  "name": "rig-preview",
  "compatibility_date": "2026-10-23",
  "workers_dev": true,
  // Off: every version would otherwise keep its own public link, marker and all.
  "preview_urls": false,
  "assets": { "directory": "../var/preview" }
}
